# Copy to .env.local (gitignored) and adjust. None of these are secrets - the OIDC client id is
# public by design (adr/0023's own console is a public client, no client secret - PKCE is what
# proves possession instead), same status as the widget's own site key (api-design.md).

# Ago.Chat.Api's own origin - http://localhost:5009 for the local dotnet-run fast loop
# (local-dev.md).
VITE_API_BASE_URL=http://localhost:5009

# Must match Ago.Chat.Api's own Auth:Keycloak:Authority *exactly* - issuer validation is an exact
# string match (local-dev.md's own documented 127.0.0.1-vs-localhost gotcha, 5-05). The API's
# appsettings.Development.json uses 127.0.0.1, not localhost - match it here too.
VITE_KEYCLOAK_AUTHORITY=http://127.0.0.1:8081/realms/ago-chat

VITE_KEYCLOAK_CLIENT_ID=ago-console

# Optional (8-06) - leave it out of a local .env.local unless you want to look at the notice. Set to
# exactly "true" on a deployment whose operator login is published, which turns on the shell strip
# telling the operator the conversations are strangers' and public. .env.production sets it, because
# that build is the public demo (adr/0026).
# VITE_PUBLIC_DEMO=true

# Optional (19-03) - Ago.Faq.Api's own origin, a *different* backend than VITE_API_BASE_URL above, on
# its own repository's own deploy (ago-faq, not ago-chat - config.ts's own remarks have the full
# reasoning). Only the AI FAQ knowledge-base editor (/settings/faq) needs this; leaving it unset does
# not stop the rest of this console from working, that one screen shows "not configured" instead.
# Uncomment once ago-faq's own API is running locally.
# VITE_FAQ_API_BASE_URL=http://localhost:5057

# Optional (22-06, adr/0093) - Ago.Calendar.Api's own origin, a *different* backend than
# VITE_API_BASE_URL above, on its own repository's own deploy (ago-calendar, not ago-chat -
# config.ts's own remarks have the full reasoning). Only the six calendar screens need this; leaving
# it unset does not stop the rest of this console from working, those screens are simply absent from
# the navigation instead of erroring.
# VITE_CALENDAR_API_BASE_URL=http://localhost:5011
