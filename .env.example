# Copy to .env.local (gitignored) and adjust. None of these are secrets - the OIDC client id is
# public by design (adr/0023's own console is a public client, no client secret - PKCE is what
# proves possession instead), same status as the widget's own site key (api-design.md).

# Ago.Chat.Api's own origin - http://localhost:5009 for the local dotnet-run fast loop
# (local-dev.md).
VITE_API_BASE_URL=http://localhost:5009

# Must match Ago.Chat.Api's own Auth:Keycloak:Authority *exactly* - issuer validation is an exact
# string match (local-dev.md's own documented 127.0.0.1-vs-localhost gotcha, 5-05). The API's
# appsettings.Development.json uses 127.0.0.1, not localhost - match it here too.
VITE_KEYCLOAK_AUTHORITY=http://127.0.0.1:8081/realms/ago-chat

VITE_KEYCLOAK_CLIENT_ID=ago-console
